{
  "name": "alphabook-monorepo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "benchmark:fixture": "node --import tsx packages/tooling/scripts/run-benchmark-fixture.ts",
    "benchmark:comprehensive": "node --import tsx packages/tooling/scripts/run-comprehensive-baseline.ts",
    "benchmark:sample": "node --import tsx packages/tooling/scripts/export-benchmark-sample.ts",
    "benchmark:sample-topical": "node --import tsx packages/tooling/scripts/export-topical-benchmark-sample.ts",
    "benchmark:compare-models": "node --import tsx packages/tooling/scripts/run-comprehensive-model-comparison.ts",
    "benchmark:grief": "node --import tsx packages/tooling/scripts/run-grief-benchmark.ts",
    "benchmark:analyze-model-selection": "node --import tsx packages/tooling/scripts/analyze-model-selection.ts",
    "benchmark:real-ir": "node --import tsx packages/tooling/scripts/run-real-ir-benchmark.ts",
    "migrate": "tsx packages/tooling/scripts/migrate.ts",
    "validate:oss": "npm run typecheck -w @alphabook/implementations && npm run test -w @alphabook/implementations && npm run typecheck -w @alphabook/platform && npm run test -w @alphabook/platform && npm run typecheck -w @alphabook/db && npm run test -w @alphabook/db && npm run typecheck -w @alphabook/source-gutenberg && npm run test -w @alphabook/source-gutenberg && npm run typecheck -w @alphabook/source-fixture && npm run test -w @alphabook/source-fixture && npm run typecheck -w @alphabook/source-supreme-court && npm run test -w @alphabook/source-supreme-court && npm run typecheck -w @alphabook/shared && npm run typecheck -w @alphabook/ingest && npm run test -w @alphabook/ingest && npm run typecheck -w @alphabook/frontend && npm run typecheck -w @alphabook/alphajustice-frontend && npm run typecheck -w @alphabook/orchestrator-worker && npm run typecheck -w @alphabook/alphajustice-orchestrator && node --import tsx --test apps/orchestrator-worker/test/store.test.ts apps/orchestrator-worker/test/platform-repository.test.ts apps/orchestrator-worker/test/db-repository.test.ts apps/orchestrator-worker/test/document-api.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:frontend": "npm run dev -w @alphabook/frontend",
    "dev:alphajustice:frontend": "npm run dev -w @alphabook/alphajustice-frontend",
    "dev:orchestrator": "npm run dev -w @alphabook/orchestrator-worker",
    "dev:alphajustice:orchestrator": "wrangler dev -c apps/alphajustice-orchestrator/wrangler.toml",
    "dev:orchestrator:node": "npm run dev:node -w @alphabook/orchestrator-worker",
    "deploy:orchestrator": "npm run deploy -w @alphabook/orchestrator-worker",
    "deploy:alphajustice:frontend": "npm run deploy -w @alphabook/alphajustice-frontend",
    "deploy:alphajustice:orchestrator": "npm run deploy -w @alphabook/alphajustice-orchestrator",
    "dev:runtime": "npm run dev -w @alphabook/runtime",
    "dev:ingest": "npm run dev -w @alphabook/ingest",
    "test:ui": "npm run test:e2e -w @alphabook/frontend"
  },
  "dependencies": {
    "@alphabook/benchmark-core": "0.1.0",
    "@alphabook/corpus-core": "0.1.0",
    "@alphabook/corpus-text": "0.1.0",
    "@alphabook/db": "0.1.0",
    "@alphabook/implementations": "0.1.0",
    "@alphabook/platform": "0.1.0",
    "@alphabook/shared": "0.1.0",
    "@alphabook/source-fixture": "0.1.0",
    "@alphabook/source-gutenberg": "0.1.0",
    "@alphabook/source-supreme-court": "0.1.0",
    "@assistant-ui/react": "^0.12.17",
    "@assistant-ui/react-ui": "^0.2.1",
    "@aws-sdk/client-s3": "^3.888.0",
    "@fontsource/manrope": "^5.2.6",
    "@fontsource/newsreader": "^5.2.8",
    "@hono/node-server": "^1.19.6",
    "@neondatabase/serverless": "^1.0.1",
    "@workos-inc/node": "^8.9.0",
    "hono": "^4.11.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "wrangler": "^4.72.0"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["vite/client", "node"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "rootDir": "../../",
    "outDir": "dist",
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "playwright.config.ts",
    "../../packages/corpus-core/src/**/*.ts",
    "../../packages/corpus-text/src/**/*.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/source-gutenberg/src/**/*.ts"
  ]
}

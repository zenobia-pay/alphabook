alpha-book.org, www.alpha-book.org, api.alpha-book.org {
  tls /etc/letsencrypt/live/alpha-book.org/fullchain.pem /etc/letsencrypt/live/alpha-book.org/privkey.pem
  encode zstd gzip

  route {
    handle_path /api/* {
      reverse_proxy alphabook-api:8787
    }

    @api path /chat /health /me /notifications* /auth/* /claim/* /skill.md /v1/*
    handle @api {
      reverse_proxy alphabook-api:8787
    }

    handle /assets/* {
      root * /srv/frontend
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }

    @static path_regexp static (?i).*\.(?:css|js|mjs|json|map|png|apng|jpg|jpeg|gif|svg|ico|webp|avif|woff2?|ttf|otf|eot|txt|xml|webmanifest|pdf|md)$
    handle @static {
      root * /srv/frontend
      header Cache-Control "public, max-age=86400"
      file_server
    }

    handle {
      root * /srv/frontend
      header Cache-Control "no-store"
      try_files {path} /index.html
      file_server
    }
  }
}

http://origin.alpha-book.org {
  encode zstd gzip


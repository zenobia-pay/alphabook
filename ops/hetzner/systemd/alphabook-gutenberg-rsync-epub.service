[Unit]
Description=AlphaBook Project Gutenberg EPUB/RDF rsync mirror refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=ALPHABOOK_ROOT=/srv/alphabook
Environment=GUTENBERG_MIRROR_ROOT=/srv/alphabook/gutenberg
ExecStart=/srv/alphabook/bin/gutenberg-rsync-epub.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
